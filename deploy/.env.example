# Скопируйте в deploy/.env (файл .env в репозиторий не попадает).
# Имя сервера: с ним включается HTTPS (нужен публичный DNS на этот сервер и открытые порты 80 и 443).
SITE_ADDRESS=hack-led-20-vm1-12902f.vmaas-spirit.t-education.com
SEED_DEMO=true
# Пароль демо-аккаунта (логин demo) для жюри; задайте свой, если не хотите значение по умолчанию
# DEMO_PASSWORD=demo-pereezd

# Необязательно: персональный AI-план. Ключ остаётся только на сервере.
# Совместимый Chat Completions API с response_format=json_object и max_tokens.
# Spirit: проверенный базовый URL с /v1, без /chat/completions на конце.
AI_API_KEY=
AI_BASE_URL=https://llm-proxy.spirit.t-education.com/v1
AI_MODEL=openrouter/anthropic/claude-haiku-5.5
# Необязательно: отдельная модель для фото (опись коробки, раскладка комнаты), тот же ключ Spirit;
# должна понимать изображения. Пусто - фото идут в AI_MODEL
AI_VISION_MODEL=
# Необязательно: свой ключ Spirit для второй модели (другой аккаунт); пусто - общий AI_API_KEY
AI_VISION_API_KEY=
AI_REQUESTS_PER_HOUR=10
AI_GLOBAL_REQUESTS_PER_DAY=50
AI_TIMEOUT_SECONDS=45
# Ключ Google Maps JavaScript API (Places API New) для подсказок адреса; без него поле адреса обычное.
# Ограничьте ключ в Google Cloud по HTTP referrer: https://<SITE_ADDRESS>/*
# GOOGLE_MAPS_API_KEY=
# Аппендер логов в Sage: адрес Logs Collector с группой и Spirit API ключ (Мониторинг -> Sage API ключи).
# SAGE_LOGS_URL=https://<хост коллектора>/api/hack-led-20/multiline/
# SAGE_API_KEY=
# Коллектор трейсов Sage (OTLP gRPC, ключ тот же SAGE_API_KEY). Хост уточнить у организаторов:
# SAGE_TRACES_ENDPOINT=https://<хост коллектора трейсов>:4319
# Ключ MapTiler (cloud.maptiler.com -> Account -> Keys) для подсказок адреса; важнее Google, если заданы оба.
# В настройках ключа разрешите HTTP origin сайта.
# MAPTILER_API_KEY=
