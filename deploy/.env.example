# Скопируйте в deploy/.env (файл .env в репозиторий не попадает).
# Имя сервера: с ним включается HTTPS (нужен публичный DNS на этот сервер и открытые порты 80 и 443).
SITE_ADDRESS=hack-led-20-vm1-12902f.vmaas-spirit.t-education.com
SEED_DEMO=true
# Пароль демо-аккаунта (логин demo) для жюри; задайте свой, если не хотите значение по умолчанию
# DEMO_PASSWORD=demo-pereezd

# Необязательно: персональный AI-план. Ключ остаётся только на сервере.
# Совместимый Chat Completions API с response_format=json_object и max_tokens.
# Spirit: корневой URL из примера Chat Completions, без /chat/completions на конце.
AI_API_KEY=
AI_BASE_URL=https://llm-proxy.spirit.t-education.com
AI_MODEL=openrouter/google/gemini-3.1-flash-lite
AI_REQUESTS_PER_HOUR=10
AI_GLOBAL_REQUESTS_PER_DAY=50
