# Обратный прокси с автоматическим HTTPS (сертификат Let's Encrypt получается и продлевается сам).

# Таймауты против медленных атак (клиент держит соединение, присылая запрос по байту): заголовки - за 10 с,
# тело - за 60 с (фото до 4 МБ с телефона), ответ - до 120 с (отсчёт идёт с конца заголовков: загрузка фото
# до 60 с плюс ответ ИИ до 45 с), простой - 2 мин
{
	servers {
		timeouts {
			read_header 10s
			read_body 60s
			write 120s
			idle 2m
		}
	}
}

# SITE_ADDRESS - имя сервера, например hack-led-20-vm1-12902f.vmaas-spirit.t-education.com:
#   с именем Caddy включает HTTPS и перенаправляет http -> https;
#   без имени (по умолчанию :80) работает обычный HTTP, например при локальном запуске.
{$SITE_ADDRESS::80} {
	encode gzip
	# заголовки безопасности: только HTTPS (HSTS), без угадывания типов, сайт нельзя встроить в чужую рамку,
	# ссылка на другой сайт не уносит полный адрес; камера и микрофон - только самому сайту (сканер QR, голосовой ввод)
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		-Server
	}
	# больше 8 МБ телу запроса не нужно (фото для ИИ - до 4 МБ в base64); гигантские тела отсекаются здесь
	request_body {
		max_size 8MB
	}
	reverse_proxy app:8000
}
