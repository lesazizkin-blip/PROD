# Для docker-compose (скопируй в .env). Локально можно ничего не задавать: подойдут значения по умолчанию.
# На СЕРВЕРЕ: APP_ENV=production, и приложение откажется стартовать с публичными паролями по умолчанию.
APP_ENV=dev
PORT=8080
POSTGRES_PASSWORD=changeme123
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
SEED_DEMO=true

# Необязательный AI-план. Только backend/.env при локальном запуске.
# Spirit: проверенный базовый URL с /v1, без /chat/completions.
# Нужен совместимый Chat Completions API с response_format=json_object и max_tokens.
AI_API_KEY=
AI_BASE_URL=https://llm-proxy.spirit.t-education.com/v1
AI_MODEL=openrouter/anthropic/claude-haiku-5.5
# Необязательно: отдельная модель для фото (опись коробки, раскладка комнаты), тот же ключ Spirit;
# должна понимать изображения. Пусто - фото идут в AI_MODEL
AI_VISION_MODEL=
# Необязательно: свой ключ Spirit для второй модели (другой аккаунт); пусто - общий AI_API_KEY
AI_VISION_API_KEY=
AI_REQUESTS_PER_HOUR=10
AI_GLOBAL_REQUESTS_PER_DAY=50
AI_TIMEOUT_SECONDS=45
