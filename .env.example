# Для docker-compose (скопируй в .env). Локально можно ничего не задавать: подойдут значения по умолчанию.
# На СЕРВЕРЕ: APP_ENV=production, и приложение откажется стартовать с публичными паролями по умолчанию.
APP_ENV=dev
PORT=8080
POSTGRES_PASSWORD=changeme123
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
SEED_DEMO=true

# Необязательный AI-план. Только backend/.env при локальном запуске.
# Spirit: для Chat Completions используется корневой URL, без /chat/completions.
# Нужен совместимый Chat Completions API с response_format=json_object и max_tokens.
AI_API_KEY=
AI_BASE_URL=https://llm-proxy.spirit.t-education.com
AI_MODEL=openrouter/google/gemini-3.1-flash-lite
AI_REQUESTS_PER_HOUR=10
AI_GLOBAL_REQUESTS_PER_DAY=50
